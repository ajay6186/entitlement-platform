# Copy to .env (git-ignored). Every value below is a local-development default; nothing here is a real credential.
# Docker Compose also reads .env, but only to fill ${ANTHROPIC_API_KEY} and ${CHAT_MODEL}; the other services get
# their settings from docker-compose.yml.

# ---- Platform API (src/config.py; every setting can be overridden with PLATFORM_*) ----
PLATFORM_ENV=dev
PLATFORM_DATABASE_URL=sqlite+aiosqlite:///./data/platform.db
PLATFORM_JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
PLATFORM_WEBHOOK_SIGNING_SECRET=whsec_dev_only_change_me_0123456789
# Pin "business now" so case-age / renewal-window results are reproducible. Remove to use the real clock.
PLATFORM_FIXED_NOW=2026-11-23T10:00:00Z
# Leave unset to use the in-process mock upstreams; set to an http(s) base URL to call real/stub upstreams.
# PLATFORM_UPSTREAM_BASE_URL=http://localhost:9100
PLATFORM_ENABLE_DEV_ENDPOINTS=true
# Default webhook subscription (created/updated at start-up). Locally it points at the API's own reference receiver;
# Docker points it at the webhook-receiver service. Event types are a JSON list.
# PLATFORM_WEBHOOK_DEFAULT_SUBSCRIBER_URL=http://localhost:8200/webhooks/receive
# PLATFORM_WEBHOOK_DEFAULT_EVENT_TYPES=["case.escalated","case.comment_added"]
# Browser origins allowed to call the API directly (the React webhook dashboard).
# PLATFORM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Chat backend (chat_backend/app.py) ----
# Needed for the Support Assistant chat. Put the real key here in .env only, never in .env.example.
# ANTHROPIC_API_KEY=sk-ant-...
# CHAT_MODEL=claude-opus-5-5

# ---- Webhook receiver (webhook_receiver/main.py) ----
# WEBHOOK_SECRET must equal PLATFORM_WEBHOOK_SIGNING_SECRET.
# WEBHOOK_SECRET=whsec_dev_only_change_me_0123456789
# RECEIVER_DB=data/receiver.db
