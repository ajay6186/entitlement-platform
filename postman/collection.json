    {
      "name": "03 Comments (idempotency)",
      "item": [
        {
          "name": "Add comment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idemKey}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{supportToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/cases/CS-10232/comments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "cases",
                "CS-10232",
                "comments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"We are investigating this issue.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"not replayed\", () => pm.expect(pm.response.headers.get(\"Idempotent-Replayed\")).to.eql(\"false\"));",
                  "pm.collectionVariables.set(\"commentId\", pm.response.json().id);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"idemKey\", \"pm-\" + Date.now());"
                ]
              }
            }
          ]
        },
        {
          "name": "Retry same key -> replayed, no duplicate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idemKey}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{supportToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/cases/CS-10232/comments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "cases",
                "CS-10232",
                "comments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"We are investigating this issue.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"replayed\", () => pm.expect(pm.response.headers.get(\"Idempotent-Replayed\")).to.eql(\"true\"));",
                  "pm.test(\"same comment\", () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"commentId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Same key, different body -> 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idemKey}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{supportToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/cases/CS-10232/comments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "cases",
                "CS-10232",
                "comments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Something else.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"problem+json\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));",
                  "pm.test(\"has correlation id\", () => pm.expect(pm.response.json().correlation_id).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Missing Idempotency-Key -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{supportToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/cases/CS-10232/comments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "cases",
                "CS-10232",
                "comments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"x\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 Escalation",
      "item": [
        {
          "name": "Support agent -> 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
