    {
      "name": "02 Cases search",
      "item": [
        {
          "name": "Search P1 open Platinum, page 1",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{supportToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/cases?priority=P1&status=open&support_tier=Platinum&limit=3",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "cases"
              ],
              "query": [
                {
                  "key": "priority",
                  "value": "P1"
                },
                {
                  "key": "status",
                  "value": "open"
                },
                {
                  "key": "support_tier",
                  "value": "Platinum"
                },
                {
                  "key": "limit",
                  "value": "3"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"3 results, sorted\", () => pm.expect(b.data.map(c => c.id)).to.eql([\"CS-10231\",\"CS-10245\",\"CS-10238\"]));",
                  "pm.test(\"has cursor\", () => pm.expect(b.page.has_more).to.be.true);",
                  "pm.collectionVariables.set(\"nextCursor\", b.page.next_cursor);"
                ]
              }
            }
          ]
        },
        {
          "name": "Search page 2 with cursor",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{supportToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/cases?priority=P1&status=open&support_tier=Platinum&limit=3&cursor={{nextCursor}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "cases"
              ],
              "query": [
                {
                  "key": "priority",
                  "value": "P1"
                },
                {
                  "key": "status",
                  "value": "open"
                },
                {
                  "key": "support_tier",
                  "value": "Platinum"
                },
                {
                  "key": "limit",
                  "value": "3"
                },
                {
                  "key": "cursor",
                  "value": "{{nextCursor}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"remaining results, no overlap\", () => pm.expect(pm.response.json().data.map(c => c.id)).to.eql([\"CS-10234\",\"CS-10232\",\"CS-10233\"]));"
                ]
